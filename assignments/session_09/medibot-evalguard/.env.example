# --- Target system (MediBot, session_05) ---
GROQ_API_KEY=gsk_your_key_here

# --- Guardrail models (purpose-built classifiers, not general LLMs) ---
INPUT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
INPUT_GUARD_THRESHOLD=0.5
OUTPUT_POLICY_MODEL=openai/gpt-oss-safeguard-20b

# --- LLM-as-judge: a different family from the generator, so it cannot self-prefer ---
JUDGE_MODEL=qwen/qwen3.8-27b

# --- Observability ---
LANGSMITH_API_KEY=lsv2_your_key_here
LANGSMITH_PROJECT=medibot-evalguard
LANGSMITH_TRACING=true

# --- Target system wiring ---
MEDIBOT_ROOT=../../session_05/medibot
